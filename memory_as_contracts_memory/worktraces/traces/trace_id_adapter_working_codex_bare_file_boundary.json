  "recall_queries": [
    {
      "query": "Should Codex prompt intake surface the package-lock edit restriction?",
      "probe": {
        "type": "prompt",
        "user_turn": "Need to update package-lock.json after changing package metadata."
      },
      "expected_information": [
        {
          "value": "package-lock.json",
          "matcher": "substring"
        },
        {
          "value": "do not edit",
          "matcher": "substring"
        }
      ]
    },
    {
      "query": "Should Codex block editing package-lock.json?",
      "probe": {
        "type": "gate",
        "tool_name": "apply_patch",
        "tool_input": {
          "path": "package-lock.json"
        },
        "intent": "edit package lockfile"
      },
      "expected_information": [
        {
          "value": "deny",
          "matcher": "substring"
        },
        {
          "value": "package-lock.json",
          "matcher": "substring"
        }
      ]
    },
    {
      "query": "Should Codex allow editing package.json under a package-lock-only rule?",
      "probe": {
        "type": "gate",
        "tool_name": "apply_patch",
        "tool_input": {
          "path": "package.json"
        },
        "intent": "edit package metadata"
      },
      "expected_information": [
        {
          "value": "\"decision\": \"allow\"",
          "matcher": "substring"
        }
      ]
    },
    {
      "query": "Should Codex allow reading package-lock.json?",
      "probe": {
        "type": "gate",
        "tool_name": "read_file",
        "tool_input": {
          "path": "package-lock.json"
        },
        "intent": "inspect lockfile"
      },
      "expected_information": [
        {
          "value": "\"decision\": \"allow\"",
          "matcher": "substring"
        }
      ]
    },
    {
      "query": "Did MAC store a target-specific lockfile rule rather than a package-wide file-write blocker?",
      "probe": {
        "type": "contracts"
      },
      "expected_information": [
        {
          "value": "package-lock.json",
          "matcher": "substring"
        },
        {
          "value": "\"level\": \"path\"",
          "matcher": "substring"
        }
      ]
    }
