  "category": "edge_case",
  "driver": "validator_budget",
  "description": "A check-update validator should update rule-local budget state from committed actions and reject a purchase that exceeds the cap.",
  "contract": {
    "id": "MAC-budget",
    "text": "Total cost must not exceed $90.",
    "effect": "deny",
    "kind": "prohibition",
    "modality": "MUST_NOT",
    "scope": {"level": "task", "workspace": "/workspace/project", "repo": "project", "task": "task-1"},
    "validator_enforcement_shape": "check_update",
    "check_patterns": [
      {"tool": "purchase"},
      {"tool": "checkout"}
    ],
    "update_patterns": [
      {"tool": "purchase"},
      {"tool": "checkout"}
    ],
    "state_fields": ["spent_cents", "seen_entry_seqs", "last_seen_seq"]
  },
  "initial_state": {"spent_cents": 0, "seen_entry_seqs": [], "last_seen_seq": null},
  "committed_actions": [
    {"tool_name": "purchase", "host_action": "purchase", "arguments": {"item": "domain", "price": "$30.00"}, "result_text": "Purchased domain"},
    {"tool_name": "checkout", "host_action": "checkout", "arguments": {"items": [{"name": "hosting", "amount": 50.0}]}, "result_text": "Purchased hosting"}
  ],
  "pending_action": {
    "tool_name": "purchase",
    "arguments": {"item": "certificate", "price": "$15.00"},
    "intent": "buy certificate"
  },
  "context": {
    "session_id": "sess-1",
    "task_id": "task-1",
    "workspace": "/workspace/project",
    "repo": "project"
  },
  "assertions": [
    {"name": "both committed purchases recorded", "path": "recorded_seqs", "expected": {"matcher": "length", "value": 2}},
    {"name": "state accumulates eighty dollars", "path": "state.spent_cents", "expected": {"matcher": "equals", "value": 8000}},
    {"name": "state revision increments for updates", "path": "state_revision", "expected": {"matcher": "equals", "value": 2}},
    {"name": "pending purchase is rejected", "path": "verdict.decision", "expected": {"matcher": "equals", "value": "reject"}},
    {"name": "rejection explains budget cap", "path": "verdict.reason", "expected": {"matcher": "contains", "value": "Budget would exceed $90"}}
  ]
}
