{
  "trace_id": "trace_id_retrieval_scope_context_shift",
  "eval_mode": "qa",
  "memory_path": "prompt_intake_retrieval",
  "category": "edge_case",
  "driver": "prompt_retrieval",
  "description": "Prompt intake should surface global preferences and path/action-relevant local rules while ignoring other workspaces.",
  "contracts": [
    {
      "id": "MAC-pref",
      "text": "Prefer concise implementation notes.",
      "effect": "prefer",
      "kind": "preference",
      "modality": "SHOULD",
      "strength": "soft",
      "source_kind": "user_profile",
      "scope": {"level": "global", "user_id": "user-1"}
    },
    {
      "id": "MAC-generated",
      "text": "Do not edit files under generated/** without asking.",
      "effect": "deny",
      "kind": "prohibition",
      "modality": "MUST_NOT",
      "scope": {"level": "path", "workspace": "/workspace/project", "repo": "project", "path_globs": ["generated/**"]},
      "semantics": {"actions": ["file.write"], "tags": ["file_write", "workspace_write"]},
      "tool_patterns": [
        {"tool": "file.write", "args": {"path": {"path_glob": "generated/**"}}},
        {"tool": "apply_patch", "args": {"patch": {"mentions_path_glob": "generated/**"}}}
      ]
    },
    {
      "id": "MAC-other-workspace",
      "text": "Do not edit files under generated/** in the other workspace.",
      "effect": "deny",
      "kind": "prohibition",
      "modality": "MUST_NOT",
      "scope": {"level": "path", "workspace": "/workspace/other", "repo": "other", "path_globs": ["generated/**"]},
      "semantics": {"actions": ["file.write"], "tags": ["file_write"]},
      "tool_patterns": [
        {"tool": "file.write", "args": {"path": {"path_glob": "generated/**"}}}
      ]
    }
  ],
  "prompt_context": {
    "host": "codex",
    "agent_family": "codex",
    "session_id": "sess-1",
    "task_id": "task-1",
    "user_id": "user-1",
    "workspace": "/workspace/project",
    "repo": "project",
    "user_turn": "Please patch generated/core.py and keep the summary short."
  },
  "assertions": [
    {
      "name": "global preference is retrieved",
      "path": "packet_ids",
      "expected": {"matcher": "contains", "value": "MAC-pref"}
    },
    {
      "name": "path-specific generated rule is retrieved",
      "path": "packet_ids",
      "expected": {"matcher": "contains", "value": "MAC-generated"}
    },
    {
      "name": "different workspace rule is filtered out",
      "path": "packet_ids",
      "expected": {"matcher": "not_contains", "value": "MAC-other-workspace"}
    },
    {
      "name": "rendered prompt is compact plain text",
      "path": "rendered",
      "expected": {"matcher": "contains", "value": "Local reminders"}
    },
    {
      "name": "rendered prompt avoids JSON payload framing",
      "path": "rendered",
      "expected": {"matcher": "not_contains", "value": "{\""}
    }
  ]
}
