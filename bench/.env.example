# Benchmark LLM config
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-5.1

# Benchmark embedding config
EMBEDDING_API=
EMBEDDING_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=BAAI/bge-m3

# number of item return per query
MAC_MEMORY_TOP_K=10

# Mem0 OSS infer LLM config
MEM_LLM_MODEL=
MEM_API_KEY=
MEM_BASE_URL=
MEM_LLM_MAX_TOKENS=4096

# Optional: Mem0 Platform API (legacy; OSS mode does not use this)
MEM0_API_KEY=

# CCTU tool simulator matching: exact (default) or suggest (top-2 did-you-mean hints)
CCTU_TOOL_MATCH_MODE=exact
CCTU_TOOL_MATCH_MIN_SCORE=0.35