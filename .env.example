OPENAI_API_KEY=
OPENAI_BASE_URL=
MAC_LLM_MODEL=
MAC_LLM_TIMEOUT_SECONDS=60
MAC_DB_PATH=.mac/contracts.sqlite
MAC_LOG_PATH=.mac/mac.log
MAC_LOG_LEVEL=INFO

# Benchmark trajectory-generation models.
# Keep the exact provider IDs here so manifests can hash and replay runs.
BENCH_PRIMARY_MODEL=GLM-5.1
BENCH_FALLBACK_MODEL=Kimi-K2.6
BENCH_PRIMARY_MODEL_ID=
BENCH_FALLBACK_MODEL_ID=

# OpenHands reads these directly. Prefer mapping them to the same endpoint used
# by MAC unless a source-specific run requires a different provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENHANDS_PROVIDER_BASE_URL=

# OpenCode provider configs should reference these with {env:...}.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=

# Optional provider-specific aliases for GLM/Kimi endpoints.
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL_ID=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL_ID=
